<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Linked into voxtmini-helper (__TEXT,__info_plist; Package.swift): the
     helper's identity and version (helper.hello) when it runs on its own.
     Inside VoxtMini.app macOS attributes its permissions to the app (the
     responsible process) and asks with the app's usage descriptions
     (mygo.json); these are for a helper run from a terminal.
     scripts/build-helper.sh keeps the version in step with mygo.json. -->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>dev.hehehai.voxtmini.helper</string>
	<key>CFBundleName</key>
	<string>voxtmini-helper</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1.0-beta.5</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 the SGLang-Omni and VoxtMini contributors. Licensed under the Apache License 2.0.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>VoxtMini records your voice while you use its shortcut and recognises it on this Mac, unless you choose a remote speech service for a feature: then that feature's recordings go to the service.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>With Apple Speech chosen, macOS recognises your recordings on this Mac only: the audio never leaves it.</string>
</dict>
</plist>
