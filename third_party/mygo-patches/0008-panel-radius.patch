diff --git a/ui/panel_radius_test.go b/ui/panel_radius_test.go
new file mode 100644
index 0000000..9c55ad3
--- /dev/null
+++ b/ui/panel_radius_test.go
@@ -0,0 +1,25 @@
+package ui
+
+import "testing"
+
+func TestPanelRadius(t *testing.T) {
+	th := LightTheme()
+	if got := th.panelRadius(); got != th.Radius+2 {
+		t.Errorf("default panel radius %v, want Radius+2", got)
+	}
+	if got := th.optionRadius(); got != th.Radius {
+		t.Errorf("default option radius %v, want Radius", got)
+	}
+	th.PanelRadius = 12
+	if got := th.panelRadius(); got != 12 {
+		t.Errorf("panel radius %v, want 12", got)
+	}
+	// Concentric: the panel's padding is Space(1).
+	if got, want := th.optionRadius(), 12-th.Space(1); got != want {
+		t.Errorf("option radius %v, want %v", got, want)
+	}
+	th.PanelRadius = 2
+	if got := th.optionRadius(); got != 0 {
+		t.Errorf("option radius %v, want 0", got)
+	}
+}
